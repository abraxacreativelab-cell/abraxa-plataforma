# ─────────────────────────────────────────────────────────────────────────────
# ABRAXA Plataforma — plantilla de entorno
#
# Copia a .env y llena. .env está en .gitignore y el gate de CI falla si un
# secreto entra al diff. NUNCA pongas un valor real en este archivo.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Supabase ─────────────────────────────────────────────────────────────────
# Proyecto: abraxa-plataforma (ref ievnkmodselrlkazkzoy, us-east-1)
SUPABASE_URL=https://ievnkmodselrlkazkzoy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Conexión directa de Postgres. La usan el runner de migraciones y pg-boss.
# Session pooler (puerto 5432) para migraciones; pg-boss también lo requiere.
DATABASE_URL=postgresql://postgres.ievnkmodselrlkazkzoy:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── API / web ────────────────────────────────────────────────────────────────
API_PORT=3100
API_BASE_URL=http://localhost:3100
# En el navegador SIEMPRE relativa en producción (nginx enruta /api).
NEXT_PUBLIC_API_BASE_URL=
WEB_PORT=3000
APP_BASE_URL=https://mi.abraxa.club

# Secreto compartido entre el BFF de Next y la API. Fail-closed en producción.
PROXY_SECRET=

# ── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Modelos ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Canales ──────────────────────────────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Cobro ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
