{
  "name": "@abraxa/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de agentes: router de proveedores, tools, usage_ledger y presupuesto. Handoff H3.",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./meta": { "types": "./src/meta.ts", "default": "./src/meta.ts" }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check:pricing": "esbuild src/bin/check-pricing.ts --bundle --platform=node --format=esm --target=node22 --log-level=warning --outfile=dist/check-pricing.mjs && node dist/check-pricing.mjs",
    "measure:cache": "esbuild src/bin/measure-cache.ts --bundle --platform=node --format=esm --target=node22 --log-level=warning --outfile=dist/measure-cache.mjs && node dist/measure-cache.mjs"
  },
  "dependencies": {
    "@abraxa/config": "*",
    "@abraxa/db": "*",
    "express": "^4.21.2",
    "@anthropic-ai/sdk": "^0.33.1", "js-yaml": "^4.1.0", "zod": "^3.24.1"
  }
}
